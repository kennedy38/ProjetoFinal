okeColor=#333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="1005" width="560" height="195" as="geometry"/></mxCell><mxCell id="a46" value="&lt;font style=&quot;font-size:11px&quot;&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;mentoria_academica&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;schema.sql + migrações&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;papel mentoria_app&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;verticalAlign=top;align=center;spacingTop=2;spacingLeft=6;spacingRight=6;fillColor=#fffbea;strokeColor=#333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="1075" width="255" height="110" as="geometry"/></mxCell><mxCell id="i47" value="" style="shape=note;size=6;fillColor=#ffffff;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="1613" y="1081" width="14" height="18" as="geometry"/></mxCell><mxCell id="a48" value="&lt;font style=&quot;font-size:11px&quot;&gt;«artifact»&lt;/font&gt;&lt;br&gt;&lt;b&gt;backup pg_dump -Fc&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cron diário 03:00 · 30 dias&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cópia: Lightsail Object Storage&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;verticalAlign=top;align=center;spacingTop=2;spacingLeft=6;spacingRight=6;fillColor=#fffbea;strokeColor=#333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1645" y="1075" width="255" height="110" as="geometry"/></mxCell><mxCell id="i49" value="" style="shape=note;size=6;fillColor=#ffffff;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="1878" y="1081" width="14" height="18" as="geometry"/></mxCell><mxCell id="e50" style="html=1;endArrow=open;endSize=10;dashed=0;rounded=0;strokeColor=#333;strokeWidth=1.2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="685" as="sourcePoint"/><mxPoint x="1640" y="745" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t51" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;HTTP · 127.0.0.1:3000 (loopback)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1648" y="697" width="300" height="30" as="geometry"/></mxCell><mxCell id="e52" style="html=1;endArrow=open;endSize=10;dashed=0;rounded=0;strokeColor=#333;strokeWidth=1.2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1640" y="945" as="sourcePoint"/><mxPoint x="1640" y="1005" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t53" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;TCP · 127.0.0.1:5432 · scram-sha-256&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1648" y="957" width="300" height="30" as="geometry"/></mxCell><mxCell id="e54" style="html=1;endArrow=open;endSize=10;dashed=0;rounded=0;strokeColor=#333;strokeWidth=1.6;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="237" as="sourcePoint"/><mxPoint x="1700" y="515" as="targetPoint"/><Array as="points"><mxPoint x="1100" y="290"/><mxPoint x="1700" y="290"/></Array></mxGeometry></mxCell><mxCell id="t55" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;HTTPS · TCP 443 (TLS) — usuários finais&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1255" y="272" width="420" height="20" as="geometry"/></mxCell><mxCell id="e56" style="html=1;endArrow=open;endSize=10;dashed=0;rounded=0;strokeColor=#333;strokeWidth=1.6;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140" y="237" as="sourcePoint"/><mxPoint x="1140" y="515" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t57" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;HTTPS · TCP 443 — equipe&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;e homologação (staging)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="930" y="462" width="202" height="30" as="geometry"/></mxCell><mxCell id="e58" style="html=1;endArrow=open;endSize=10;dashed=0;rounded=0;strokeColor=#333;strokeWidth=1.2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="330" as="sourcePoint"/><mxPoint x="1860" y="237" as="targetPoint"/><Array as="points"><mxPoint x="450" y="305"/><mxPoint x="1860" y="305"/></Array></mxGeometry></mxCell><mxCell id="t59" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;git push · HTTPS&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="460" y="285" width="260" height="20" as="geometry"/></mxCell><mxCell id="e60" style="html=1;endArrow=open;endSize=10;dashed=0;rounded=0;strokeColor=#666;strokeWidth=1.2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1520" y="237" as="sourcePoint"/><mxPoint x="1240" y="450" as="targetPoint"/><Array as="points"><mxPoint x="1520" y="270"/><mxPoint x="1240" y="270"/></Array></mxGeometry></mxCell><mxCell id="t61" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;git pull · HTTPS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;(deploy develop)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1248" y="400" width="160" height="40" as="geometry"/></mxCell><mxCell id="e62" style="html=1;endArrow=open;endSize=10;dashed=0;rounded=0;strokeColor=#666;strokeWidth=1.2;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1940" y="237" as="sourcePoint"/><mxPoint x="1940" y="450" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t63" value="&lt;font style=&quot;font-size:9px&quot;&gt;&lt;b&gt;git pull · HTTPS&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;(deploy main)&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=right;verticalAlign=top;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="1838" y="380" width="100" height="40" as="geometry"/></mxCell><mxCell id="o64" value="&lt;b&gt;Notação e premissas&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cubo = nó «device» ou «executionEnvironment» · retângulo com ícone = «artifact» · linha = caminho de comunicação (protocolo · porta)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Frontend e API são servidos pela MESMA aplicação Node.js (express.static + /api).&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PostgreSQL NÃO é exposto: escuta só em localhost e a porta 5432 fica fechada no firewall.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Conexões internas (Nginx → Node → PostgreSQL) usam a interface de loopback da própria instância.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Administração dos servidores: SSH (porta 22) com chave, restrito ao IP da equipe.&lt;/font&gt;&lt;/div&gt;" style="shape=note;size=14;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fillColor=#fff8d6;strokeColor=#333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1258" width="900" height="125" as="geometry"/></mxCell><mxCell id="o65" value="&lt;b&gt;Backup, disponibilidade e metas (não são resultados medidos)&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Snapshots automáticos diários do Lightsail (7 retidos) + pg_dump diário (30 dias) + snapshot manual antes de cada deploy.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Metas de projeto: p95 ≤ 300 ms com 150 usuários simultâneos · base de 10.000 usuários cadastrados.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Disponibilidade-alvo de 99,5% (meta, não SLA): uma única instância por ambiente, sem redundância.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Evolução se a meta subir: Lightsail Load Balancer + 2ª instância e banco gerenciado.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Custos verificados em aws.amazon.com/lightsail/pricing (06/11/2026) — ver 07-planejamento.md.&lt;/font&gt;&lt;/div&gt;" style="shape=note;size=14;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fillColor=#fff8d6;strokeColor=#333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="1258" width="980" height="125" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>