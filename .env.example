# =====================================================================
# MentorIA Acadêmica — variáveis de ambiente (MODELO)
# Copie para ".env" e preencha. NUNCA versione o arquivo .env.
# Nenhum valor abaixo é uma credencial real.
# =====================================================================

# Ambiente: development | test | staging | production
NODE_ENV=development

# Porta HTTP da aplicação Node.js/Express (atrás do Nginx em staging/produção)
PORT=3000

# Conexão PostgreSQL (biblioteca pg). Em staging/produção o host é sempre localhost.
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgres://mentoria_app:TROQUE_ESTA_SENHA@localhost:5432/mentoria_dev
# Banco separado usado pelos testes de integração (node:test + Supertest)
DATABASE_URL_TEST=postgres://mentoria_app:TROQUE_ESTA_SENHA@localhost:5432/mentoria_test
# Conexões máximas no pool do pg
DB_POOL_MAX=10

# JWT de acesso (RNF007): validade de 15 minutos, sem refresh token
# Gere um segredo forte com: openssl rand -base64 48
JWT_SECRET=GERE_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
JWT_EXPIRES_IN=15m

# Custo do bcryptjs (mínimo do projeto: 12)
BCRYPT_SALT_ROUNDS=12

# Regras de agendamento
EXPIRACAO_PENDENTE_HORAS=48
EXPIRACAO_JOB_INTERVALO_MIN=5

# Logs: error | warn | info | debug
LOG_LEVEL=info
