9px&quot;&gt;&lt;b&gt;SQL — protocolo PostgreSQL (pg)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;TCP 5432 somente em localhost&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;spacing=0;" vertex="1" parent="1"><mxGeometry x="915" y="1062" width="260" height="28" as="geometry"/></mxCell><mxCell id="k87" value="&lt;font style=&quot;font-size:11px&quot;&gt;«component» «database»&lt;/font&gt;&lt;br&gt;&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;banco mentoria_academica · 10 tabelas · 2 visões&lt;/font&gt;" style="html=1;whiteSpace=wrap;verticalAlign=top;align=center;spacingTop=2;spacingLeft=8;spacingRight=8;fillColor=#e8f0fe;strokeColor=#333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="1100" width="400" height="70" as="geometry"/></mxCell><mxCell id="i88" value="" style="shape=module;jettyWidth=6;jettyHeight=4;fillColor=#ffffff;strokeColor=#333;" vertex="1" parent="1"><mxGeometry x="1074" y="1106" width="18" height="20" as="geometry"/></mxCell><mxCell id="o89" value="&lt;b&gt;Notação UML 2&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;○—  interface fornecida (lollipop)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;- - -&amp;gt;  dependência «use» (interface requerida)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;□  porta do subsistema;  ——&amp;gt;  conector «delegate»&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Cada módulo segue Controller → Service → Repository (padrões de Kennedy).&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Todos os módulos rodam no MESMO processo: um único deploy,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;um único banco, sem chamadas de rede entre módulos.&lt;/font&gt;&lt;/div&gt;" style="shape=note;size=14;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fillColor=#fff8d6;strokeColor=#333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1060" width="600" height="175" as="geometry"/></mxCell><mxCell id="o90" value="&lt;b&gt;Mapeamento com o C4 Nível 3 (Kennedy — 5 módulos)&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1. Autenticação e usuários  →  Autenticação + Usuários&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;2. Mentores e disciplinas  →  Mentorias&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;3. Disponibilidades e agendamentos  →  Agendamentos&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;4. Sessões e avaliações  →  Avaliações&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;5. Administração e relatórios  →  Administração&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Notificações internas (RF018, Could) ficam em Agendamentos.&lt;/font&gt;&lt;/div&gt;" style="shape=note;size=14;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fillColor=#fff8d6;strokeColor=#333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="1060" width="600" height="175" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>